# Nginx configuration example for serving sitemap.xml and robots.txt correctly
# Add this to your server block

server {
    listen 80;
    listen 443 ssl http2;
    server_name jpstudio.app www.jpstudio.app;

    # Root directory where Vite builds the app
    root /var/www/jpstudio/dist;
    index index.html;

    # Static files and assets - serve as-is
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|json)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Explicitly serve sitemap.xml without rewrite
    location = /sitemap.xml {
        try_files $uri =404;
        types {
            application/xml xml;
        }
        add_header Content-Type "application/xml; charset=utf-8";
        expires 24h;
        add_header Cache-Control "public, max-age=86400";
    }

    # Explicitly serve robots.txt without rewrite
    location = /robots.txt {
        try_files $uri =404;
        types {
            text/plain txt;
        }
        expires 24h;
        add_header Cache-Control "public, max-age=86400";
    }

    # Serve .well-known files (for SSL verification, etc.)
    location ^~ /.well-known/ {
        try_files $uri =404;
    }

    # SPA routing - rewrite all other requests to index.html
    location / {
        # Try to serve the file directly if it exists
        try_files $uri $uri/ /index.html;
        
        # Cache busting for HTML files
        add_header Cache-Control "public, max-age=3600";
    }

    # Deny access to sensitive files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # SSL configuration (if using HTTPS)
    # ssl_certificate /path/to/cert.pem;
    # ssl_certificate_key /path/to/key.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_ciphers HIGH:!aNULL:!MD5;
    # ssl_prefer_server_ciphers on;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss;
}
