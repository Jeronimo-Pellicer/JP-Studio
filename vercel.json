{
  "buildCommand": "npm run build",
  "framework": "vite",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/recursos\\?article=([a-z0-9-]+)$", "dest": "/recursos/$1", "status": 301 },
    { "src": "^/recursos/(?<article>[^/]+)/?$", "dest": "/recursos/$article/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
